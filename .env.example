# TC Booking – настройки. Копирайте като .env и попълнете USER и PASS.
# .env НИКОГА не се качва в git (вписан е в .gitignore).
# Доставчик без USER/PASS се пропуска.

# 3000 е на TC Prices
PORT=3100
# зад Caddy – само локално; 0.0.0.0 = достъпно отвън
HOST=127.0.0.1
# адресът на сайта, който вика API-то от браузъра (CORS); празно = само от същия адрес
CORS_ORIGIN=
# нашият сайт – снимки и описания на хотелите (npm run import-site)
SITE_URL=https://www.tours-club.com
MARKUP_PCT=0
CACHE_MIN=15

# --- Summer Tour (Sedna Agency API) – макс. 10 HotelPriceSearch/мин от тяхна страна, пазим 8 ---
SUMMER_NAME=Summer Tour
SUMMER_TYPE=sedna
SUMMER_URL=http://online.summertour.com/AgencyApi/Api
SUMMER_USER=
SUMMER_PASS=
SUMMER_RATE_PER_MIN=8
SUMMER_REMOTE=SUM

# --- Anea Travel (Sejour REST v2) ---
ANEA_NAME=Anea Travel
ANEA_TYPE=sejour
ANEA_URL=http://b2b.aneatravel.com.tr/webapi/api
ANEA_DB=ANEA
ANEA_USER=
ANEA_PASS=

# --- Irels Travel (Sejour REST v2) ---
IRELS_NAME=Irels Travel
IRELS_TYPE=sejour
IRELS_URL=http://88.248.55.246/webapi/api
IRELS_DB=IRELS2022
IRELS_USER=
IRELS_PASS=
IRELS_REMOTE=IRE

# --- Sonar Tour (Sejour REST v2) ---
SONAR_NAME=Sonar Tour
SONAR_TYPE=sejour
SONAR_URL=http://31.7.38.61/webapi/api
SONAR_DB=SONARTURIZM2020
SONAR_USER=
SONAR_PASS=

# --- Akay Tour (Sejour REST v2) ---
AKAY_NAME=Akay Tour
AKAY_TYPE=sejour
AKAY_URL=https://b2b.akaytour.com/webapi/api
AKAY_DB=AKAYSEJOUR2021
AKAY_USER=
AKAY_PASS=

# --- Peninsula (Sejour REST v2) – засега връща грешка 10000020
#     "Domain cannot be linked. Please Check SanApi settings." – чака се да включат API-то ---
PENINSULA_NAME=Peninsula
PENINSULA_TYPE=sejour
PENINSULA_URL=https://b2b.peninsula.com.tr/webapi/api
PENINSULA_DB=SEJOUR
PENINSULA_USER=
PENINSULA_PASS=
